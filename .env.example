# Required for live generation and artifact drafting
ANTHROPIC_API_KEY=

# Optional: live Composio toolkit lookup (managed auth, auth config fields).
# Without it, a static copy of Composio's managed-auth directory is used.
COMPOSIO_API_KEY=

# Optional: shared rate limiting on a public deployment. Without these, an in-memory limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Global cap on live generations per day (default 80)
DAILY_GEN_CAP=80
